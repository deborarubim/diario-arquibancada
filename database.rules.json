{
  "rules": {
    "chatGlobal": {
      "mensagens": {
        ".read": "auth != null",
        ".indexOn": ["createdAt"],
        "$mensagemId": {
          ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('uid').val() === auth.uid))",
          ".validate": "newData.hasChildren(['uid', 'autorFormatado', 'texto', 'tag', 'createdAt'])",
          "uid": {
            ".validate": "newData.val() === auth.uid"
          },
          "autorFormatado": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
          },
          "texto": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
          },
          "tag": {
            ".validate": "newData.val() === 'Geral' || newData.val() === 'Vou ao jogo hoje' || newData.val() === 'Ingresso / Setor'"
          },
          "createdAt": {
            ".validate": "newData.val() === now"
          },
          "$outro": {
            ".validate": false
          }
        }
      }
    }
  }
}
